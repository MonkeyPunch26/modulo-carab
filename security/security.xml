<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_carabineros" model="ir.module.category">
        <field name="name">Carabineros</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_carabinero_aprobador" model="res.groups">
        <field name="name">Aprobador de Carabineros</field>
        <field name="category_id" ref="module_category_carabineros"/>
        <field name="comment">Puede aprobar, renovar, rechazar y revocar las inscripciones de clientes Carabineros. Es quien confirma el ingreso.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
</odoo>
