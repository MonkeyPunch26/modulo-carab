<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="dros_carabineros.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('company-field')]" position="after">
            <div t-if="carabinero" class="mt-1">
                <span class="badge" t-att-class="carabinero.cssClass" t-esc="carabinero.label"/>
            </div>
        </xpath>
    </t>

</templates>
