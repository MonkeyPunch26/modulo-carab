<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_carabinero" model="ir.ui.view">
        <field name="name">pos.config.form.carabinero</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group name="carabineros">
                    <field name="carabinero_required"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
