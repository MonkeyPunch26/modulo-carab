<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 05:00 UTC = 01:00-02:00 hora de Chile: siempre después de la medianoche local. -->
    <record id="ir_cron_carabinero_expire" model="ir.cron">
        <field name="name">Carabineros: dejar inactivos a los clientes con vigencia vencida</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_carabinero_expire()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
