<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acciones masivas: seleccionar productos en la lista > Acción -->
    <record id="action_product_mark_public" model="ir.actions.server">
        <field name="name">Marcar como apto para público general</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.write({'carabinero_public_sale': True})</field>
    </record>
    <record id="action_product_mark_carabinero_only" model="ir.actions.server">
        <field name="name">Marcar como solo Carabineros</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.write({'carabinero_public_sale': False})</field>
    </record>
</odoo>
